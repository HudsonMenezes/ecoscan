# Copie para .env e preencha. NUNCA use o prefixo VITE_ para segredos:
# variáveis VITE_* são embutidas no JavaScript público.

# --- Backend (lidas apenas pelas funções em api/) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Origem permitida para chamar /api/* (barreira contra uso casual)
# Produção: https://ecoscan-v1.vercel.app
ALLOWED_ORIGIN=http://localhost:5173

# --- Front-end (públicas, sem segredos) ---
# Provedor de voz: "browser" (Web Speech, padrão) ou "openai"
VITE_TTS_PROVIDER=browser

# --- Scripts (dev) ---
# URL base usada no QR de demonstração (npm run qr:demo)
QR_BASE_URL=https://ecoscan-v1.vercel.app
